# ---------- Server (server/index.js) ----------
# Port for the Express API. Render sets this automatically.
PORT=8787

# Claude API key for the assistant. Server-side ONLY: never prefix with VITE_.
# Leave empty to run the assistant in rule-based "Offline guidance mode".
ANTHROPIC_API_KEY=

# Model for the assistant (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hard cap on assistant output tokens (default 1500, max 4000).
ASSISTANT_MAX_TOKENS=1500

# Upstream timeout in ms (default 20000) and requests per minute per IP (default 20).
ASSISTANT_TIMEOUT_MS=20000
ASSISTANT_RATE_LIMIT=20

# SQLite file location (default server/data/evexia.db). On Render, point this at a persistent disk.
DATABASE_PATH=

# Comma-separated list of allowed browser origins (e.g. your Vercel URL). Empty = allow all.
CORS_ORIGIN=

# Serve the built client from the API server (single-host deploy). Set to false to disable.
SERVE_CLIENT=true

# ---------- Client (client/, read at build time by Vite) ----------
# Public URL of the API when the frontend is hosted separately (e.g. Vercel → Render).
# Leave empty when the API is on the same origin (dev proxy or single-host deploy).
VITE_API_URL=

# ---------- Wearable telemetry ----------
# When set, POST /api/telemetry requires the header  x-telemetry-key: <value>
TELEMETRY_KEY=
# Raw telemetry samples are deleted after this many days (log entries are kept).
TELEMETRY_RETENTION_DAYS=7

# ---------- Real NASA data ----------
# DONKI web service base (no key needed). Change only to use a mirror.
DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI/WS/get

# ---------- Seed ----------
# Days of sample log history created by `npm run seed` (0 = none).
SEED_DAYS=21
