{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://evexia-nasa-space-app-2026.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/|models/|favicon.svg|sw.js|registerSW.js|manifest.webmanifest|workbox-).*)", "destination": "/index.html" }
  ]
}
