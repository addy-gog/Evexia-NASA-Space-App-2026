{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://evexia-nasa-space-app-2026.onrender.com" },
    { "source": "/((?!api/|assets/|models/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
